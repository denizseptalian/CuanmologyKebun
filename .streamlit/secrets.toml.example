# ============================================================
# TEMPLATE SECRETS UNTUK STREAMLIT CLOUD
#
# Di Streamlit Cloud:
# 1. Buka app di dashboard.streamlit.io
# 2. Klik Settings → Secrets
# 3. Salin isi file ini, hapus baris komentar (#),
#    lalu ganti nilai sesuai kebutuhan Anda
# ============================================================

APP_PASSWORD = "passwordanda"
SHARE_PASSWORD = "passwordshare"

# Opsional — untuk alert Telegram
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
TELEGRAM_CHAT_ID_GROUP = ""

# ============================================================
# TRADING TRACKER — GOOGLE SHEETS (WAJIB DI STREAMLIT CLOUD)
#
# Tanpa ini, data trades & dividen disimpan di file lokal dan
# HILANG setiap kali app redeploy.
#
# Cara setup:
# 1. Buka https://console.cloud.google.com → buat project baru
# 2. APIs & Services → Enable APIs → aktifkan "Google Sheets API"
# 3. IAM & Admin → Service Accounts → Create Service Account
#    (role tidak perlu diisi) → selesai
# 4. Klik service account → Keys → Add Key → JSON → download
# 5. Buat Google Spreadsheet kosong di sheets.google.com,
#    lalu SHARE spreadsheet itu ke email service account
#    (xxx@xxx.iam.gserviceaccount.com) sebagai EDITOR
# 6. Salin ID spreadsheet dari URL-nya:
#    https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
# 7. Isi bagian di bawah dengan isi file JSON dari langkah 4
# ============================================================

TRACKER_SHEET_ID = "id-spreadsheet-anda"

[gcp_service_account]
type = "service_account"
project_id = "nama-project-anda"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@xxx.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
